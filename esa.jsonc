// 阿里云 ESA「函数和 Pages」项目配置
// 纯静态站：产物即仓库根目录（index.html / assets/ / data/ / logos/）
// 数据由 GitHub Actions（.github/workflows/update.yml）定时抓取并提交，
// 推送 main 后由 ESA 自动重新部署。
//
// 注意：buildCommand 必须是非空字符串。ESA 不认空字符串，
// 会退回默认的 `npm run build`，而本站没有 package.json，构建必然失败。
{
  "name": "hot",
  "installCommand": "",
  "buildCommand": "echo 'static site, no build step'",
  "assets": {
    "directory": "./",
    "notFoundStrategy": "404Page"
  }
}
